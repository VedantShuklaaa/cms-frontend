# Base URL of the CMS backend API, including the /api/v1 prefix.
#
# Local development:
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8080/api/v1
#
# EC2 + domain (use your real domain, with HTTPS):
# NEXT_PUBLIC_API_BASE_URL=https://api.example.com/api/v1
#
# This value is inlined at build time. Set it before running `bun run build`.
